dex = 0; index < 50; index++) {\n"]]},{"start1":7420,"length1":39,"diffs":[[1,"        airbit.rotateDot(\n        1,\n        3,\n        1,\n        -10\n        )\n"]]},{"start1":7573,"length1":33,"diffs":[[1,"function simpleBatteryCheck () {\n"]]},{"start1":7945,"length1":5,"diffs":[[1,""]]},{"start1":7947,"length1":38,"diffs":[[1,"function expo (inp: number) {\n"]]},{"start1":8132,"length1":5,"diffs":[[1,""]]},{"start1":8134,"length1":1,"diffs":[[1,""]]},{"start1":8821,"length1":21,"diffs":[[1,"// Default: 0.7-0.9\n"]]},{"start1":8858,"length1":10,"diffs":[[1,"// 0.004\n"]]},{"start1":8886,"length1":19,"diffs":[[1,"// Default: 12-15\n"]]},{"start1":8924,"length1":15,"diffs":[[1,"// Default: 5\n"]]},{"start1":8951,"length1":16,"diffs":[[1,"// Default: 70\n"]]},{"start1":9174,"length1":51,"diffs":[[1,"// i2crr.setI2CPins(DigitalPin.P2, DigitalPin.P1)\n"]]},{"start1":9371,"length1":1,"diffs":[[1,""]]},{"start1":9477,"length1":45,"diffs":[[1,"    basic.showString(\"Connect battery\",100)\n"]]},{"start1":9637,"length1":38,"diffs":[[1,"basic.forever(function () {\n"]]},{"start1":9683,"length1":39,"diffs":[[1,"basic.forever(function () {\n"]]},{"start1":9746,"length1":39,"diffs":[[1,"basic.forever(function () {\n"]]},{"start1":9915,"length1":9,"diffs":[[1,"    \t\n"]]},{"start1":10138,"length1":5,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":303,"length1":39,"diffs":[[1,"        \"custom.ts\"\n"]]},{"start1":709,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"added","filename":"main.py","value":"# Draw battery icon\n# Level 4: full\n# Level 3: medium-high\n# Level 2: medium-low\n# Level 1: low\n# Level 0: Empty\ndef batteryIcon(level: number):\n    led.plot(2, 4)\n    led.plot(2, 0)\n    for index in range(4):\n        led.plot(1, index + 1)\n        led.plot(3, index + 1)\n    if level > 0:\n        index2 = 0\n        while index2 <= level:\n            led.plot(2, 5 - index2)\n            index2 += 1\n    else:\n        led.plot(0, 0)\n        led.plot(2, 2)\n        led.plot(4, 4)\ndef screen():\n    # If charging is detected\n    if pins.analog_read_pin(AnalogReadWritePin.P0) > 750:\n        # Charge mode can not happen when drone is flying\n        if arm == 0:\n            charging()\n    else:\n        if mode == 0:\n            dots()\n        if mode == 1:\n            led.plot_bar_graph(airbit.battery_level(), 100)\n        if mode == 2:\n            basic.show_number(throttle)\n        if mode == 3:\n            motorTest()\n        if mode == 4:\n            basic.clear_screen()\n            motorLed()\n        if mode == 5:\n            basic.show_number(airbit.batterym_volt())\ndef mainLoop():\n    global stable, cpuTime, startTime\n    while True:\n        # serial.writeValue(\"x\", roll)\n        # Read raw data from gyro and accelerometer\n        airbit.IMU_sensorRead()\n        airbit.calculate_angles()\n        basic.pause(1)\n        lostSignalCheck()\n        if motorTesting == False:\n            # The \"magic\" algorithm that stabilises the drone based on setpoint angle and actual angle, finding the difference and chanring motor speed to compensate.\n            airbit.stabilise_pid()\n        # If upside down while armed, disable flying\n        if abs(imuRoll) > 90:\n            stable = False\n        else:\n            stable = True\n        # Only start motors if armed, stable, motor controller and gyro is operating\n        if arm and stable and (mcExists and (gyroType > 0 and notCharging)):\n            if throttle == 0:\n                # Idle speed of motors\n                airbit.motor_speed(5, 5, 5, 5)\n            else:\n                airbit.motor_speed(motorA, motorB, motorC, motorD)\n        else:\n            # Clear registers for error compensation algorithms, do not keep errors from past flight.\n            airbit.clean_reg()\n            if motorTesting:\n                airbit.motor_speed(motorA, motorB, motorC, motorD)\n            else:\n                airbit.motor_speed(0, 0, 0, 0)\n        cpuTime = input.running_time() - startTime\n        startTime = input.running_time()\n\ndef on_button_pressed_a():\n    global mode\n    mode += -1\n    if mode < 0:\n        mode = 5\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\n# input.onButtonPressed(Button.A, function () {\n# rollPitchP += -0.1\n# basic.showNumber(rollPitchP)\n# })\ndef radioSendData():\n    radio.send_value(\"Pd\", Math.round(imuPitch))\n    radio.send_value(\"Rd\", Math.round(imuRoll))\n    radio.send_value(\"Td\", input.temperature())\n    radio.send_value(\"B\", batterymVoltSmooth)\n    radio.send_value(\"G\", input.acceleration(Dimension.Z))\n    radio.send_value(\"S\", input.sound_level())\ndef gyroAccBubble():\n    pass\n\ndef on_button_pressed_ab():\n    global mode\n    mode = 0\ninput.on_button_pressed(Button.AB, on_button_pressed_ab)\n\ndef on_button_pressed_b():\n    global mode\n    mode += 1\n    if mode > 5:\n        mode = 0\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\n# input.onButtonPressed(Button.B, function () {\n# rollPitchP += 0.1\n# basic.showNumber(rollPitchP)\n# })\ndef motorLed():\n    basic.clear_screen()\n    led.plot_brightness(0, 4, motorA)\n    led.plot_brightness(0, 0, motorB)\n    led.plot_brightness(4, 4, motorC)\n    led.plot_brightness(4, 0, motorD)\n    led.plot(Math.map(imuRoll, -15, 15, 0, 4),\n        Math.map(imuPitch, -15, 15, 4, 0))\n\ndef on_received_value(name, value):\n    global radioReceivedTime, pitch, arm, roll, throttle, yaw, rollPitchP, rollPitchI\n    radioReceivedTime = input.running_time()\n    if name == \"P\":\n        pitch = expo(value) / -3\n        pitch = Math.constrain(pitch, -15, 15)\n    if name == \"A\":\n        arm = value\n    if name == \"R\":\n        roll = expo(value) / 3\n        roll = Math.constrain(roll, -15, 15)\n    if name == \"T\":\n        throttle = value\n        throttle = Math.constrain(throttle, 0, 100)\n        if batterymVoltSmooth < 3400:\n            throttle = Math.constrain(throttle, 0, 75)\n    if name == \"Y\":\n        yaw += value * 0.1\n    if name == \"p\":\n        rollPitchP = value\n    if name == \"i\":\n        rollPitchI = value\nradio.on_received_value(on_received_value)\n\n# smartBar(0, throttle)\n# smartBar(4, airbit.batteryLevel())\ndef dots():\n    basic.clear_screen()\n    led.plot(Math.map(roll, -15, 15, 0, 4),\n        Math.map(pitch, -15, 15, 4, 0))\n    led.plot(Math.map(yaw, -30, 30, 0, 4), 4)\n    if arm:\n        led.plot(0, 0)\n    if stable and (mcExists and (gyroType > 0 and notCharging)):\n        led.plot(2, 0)\n    airbit.smart_bar(0, throttle)\n    airbit.smart_bar(4, airbit.battery_level())\ndef charging():\n    global AnalogP0Switch, oldP0, notCharging\n    if AnalogP0Switch - pins.analog_read_pin(AnalogReadWritePin.P0) > 20:\n        basic.show_string(\"Connect battery\", 100)\n    else:\n        basic.pause(200)\n    AnalogP0Switch = pins.analog_read_pin(AnalogReadWritePin.P0)\n    if pins.analog_read_pin(AnalogReadWritePin.P0) - oldP0 < 10:\n        oldP0 = pins.analog_read_pin(AnalogReadWritePin.P0)\n        basic.clear_screen()\n        for index3 in range(4):\n            batteryIcon(index3 + 1)\n            basic.pause(500)\n        notCharging = False\n    else:\n        basic.show_icon(IconNames.YES)\n        basic.show_string(\"Charge finished!\")\n        notCharging = True\n        AnalogP0Switch += 1\ndef lostSignalCheck():\n    global roll, pitch, yaw, throttle, arm\n    # Failsafe makes only sense if already flying\n    if throttle > 65 and arm:\n        if input.running_time() > radioReceivedTime + 3000:\n            roll = 0\n            pitch = 0\n            yaw = 0\n            throttle = 65\n        if input.running_time() > radioReceivedTime + 8000:\n            roll = 0\n            pitch = 0\n            yaw = 0\n            throttle = 0\n            arm = 0\ndef motorTest():\n    global motorA, motorB, motorC, motorD, motorTesting\n    motorA = 0\n    motorB = 0\n    motorC = 0\n    motorD = 0\n    motorTesting = True\n    motorB = 5\n    for index4 in range(50):\n        basic.clear_screen()\n        airbit.rotate_dot(1, 1, 1, 10)\n        basic.pause(20)\n    motorB = 0\n    motorD = 5\n    for index5 in range(50):\n        basic.clear_screen()\n        airbit.rotate_dot(3, 1, 1, -10)\n        basic.pause(20)\n    motorD = 0\n    motorC = 5\n    for index6 in range(50):\n        basic.clear_screen()\n        airbit.rotate_dot(3, 3, 1, 10)\n        basic.pause(20)\n    motorC = 0\n    motorA = 5\n    for index7 in range(50):\n        basic.clear_screen()\n        airbit.rotate_dot(1, 3, 1, -10)\n        basic.pause(20)\n    motorA = 0\n    motorTesting = False\ndef simpleBatteryCheck():\n    basic.clear_screen()\n    if airbit.batterym_volt() > 4050:\n        batteryIcon(4)\n    elif airbit.batterym_volt() > 3900:\n        batteryIcon(3)\n    elif airbit.batterym_volt() > 3750:\n        batteryIcon(2)\n    elif airbit.batterym_volt() > 3600:\n        batteryIcon(1)\n    else:\n        batteryIcon(0)\ndef expo(inp: number):\n    if inp >= 0:\n        return inp / expoSetting + inp * inp / expoFactor\n    else:\n        return inp / expoSetting - inp * inp / expoFactor\nAnalogP0Switch = 0\nyaw = 0\nroll = 0\npitch = 0\nradioReceivedTime = 0\nstartTime = 0\ncpuTime = 0\nmotorTesting = False\nthrottle = 0\nmode = 0\narm = 0\nmcExists = False\ngyroType = 0\noldP0 = 0\nexpoFactor = 0\nexpoSetting = 0\nmotorD = 0\nmotorB = 0\nmotorC = 0\nmotorA = 0\nrollPitchI = 0\nrollPitchP = 0\nbatterymVoltSmooth = 0\nimuRoll = 0\nimuPitch = 0\nnotCharging = False\nstable = False\nbatteryVolt = 0\nimuYaw = 0\nstable = True\nnotCharging = True\nradioGroup = 7\nbasic.show_number(radioGroup)\nsimpleBatteryCheck()\nbasic.pause(1000)\nimuPitch = 0\nimuRoll = 0\nbatterymVoltSmooth = 3700\n# Default: 0.7-0.9\nrollPitchP = 0.7\n# 0.004\nrollPitchI = 0.004\n# Default: 12-15\nrollPitchD = 12\n# Default: 5\nyawP = 5\n# Default: 70\nyawD = 70\nmotorA = 0\nmotorC = 0\nmotorB = 0\nmotorD = 0\nexpoSetting = 2\nexpoFactor = 45 * 45 / (45 - 45 / expoSetting)\nradio.set_group(radioGroup)\ni2crr.set_i2c_pins(DigitalPin.P2, DigitalPin.P1)\noldP0 = 1000\n# i2crr.setI2CPins(DigitalPin.P2, DigitalPin.P1)\nbasic.pause(100)\nairbit.detect_gyro()\nbasic.clear_screen()\nif gyroType == 0:\n    basic.show_string(\"NG\")\nelse:\n    basic.show_number(gyroType)\nairbit.IMU_Start()\nbasic.pause(100)\nairbit.PCA_Start()\nwhile mcExists == False:\n    airbit.PCA_Start()\n    basic.show_string(\"Connect battery\", 100)\nbasic.show_string(\"M\")\nairbit.IMU_gyro_calibrate()\nairbit.clean_reg\nwhile arm:\n    basic.show_string(\"Disarm!\")\n\ndef on_forever():\n    mainLoop()\nbasic.forever(on_forever)\n\ndef on_forever2():\n    airbit.battery_calculation()\nbasic.forever(on_forever2)\n\ndef on_forever3():\n    screen()\n    if stable == False and arm:\n        basic.show_string(\"Tilted. Please reset.\")\n    elif batterymVoltSmooth > 3400:\n        pass\n    elif batterymVoltSmooth > 3350:\n        batteryIcon(1)\n    else:\n        basic.clear_screen()\n        batteryIcon(0)\n        basic.pause(1000)\n        basic.clear_screen()\n        basic.pause(1000)\nbasic.forever(on_forever3)\n"}]},{"timestamp":1791807945833,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":2345,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"EA8.pO}OiVPsem*FF?wX\">index</variable><variable id=\"{AfHYR99)qZNwp|D{D{%\">index2</variable><variable id=\"n$l6DZ%%g`Vx^h)mVZ?f\">arm</variable><variable id=\"36ZON-58xeHMd7YyJT$u\">mode</variable><variable id=\"$}8cJ8Ro|:0tb6f;@v+U\">throttle</variable><variable id=\"B7i`Ys3[1uRy#2{+p#YD\">motorTesting</variable><variable id=\"gw*R0qZ3Gak`VKE7cXCH\">imuRoll</variable><variable id=\".[i-a@v!VfC$Cz(T0a*T\">stable</variable><variable id=\"dk#oE:nM+|co5@u|+`M